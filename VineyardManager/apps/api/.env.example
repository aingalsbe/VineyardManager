PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://vineyard:vineyard@localhost:5432/vineyard_manager
JWT_SECRET=vineyard-dev-jwt-secret-not-for-production
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
APP_URL=http://localhost:5173

# Mail (nodemailer). If SMTP is unset, forgot-password logs the reset URL and
# returns data.devResetUrl in development. Port 465 uses TLS (secure).
# SMTP_URL=smtp://user:pass@localhost:587
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Vineyard Manager <noreply@example.com>

# Daily rain check cron (6:15 AM America/Chicago). Set false to disable.
# WEATHER_CRON_ENABLED=true

# Weekly digest (Monday 6:30 AM America/Chicago). Off by default.
DIGEST_CRON_ENABLED=false
# Months the scheduled digest runs, inclusive range or comma list (e.g. 3-10 or 3,4,5).
DIGEST_SEASON_MONTHS=3-10
# Comma-separated allowlist for POST /digest/send-test.
DIGEST_TEST_RECIPIENTS=someone@example.com
