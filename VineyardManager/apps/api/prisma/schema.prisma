// Persistence slice: vineyard rows and scheduled tasks.
// User + Vineyard exist so foreign keys stay real. Parcel groupings can return later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  power_user
  manager
  viewer
}

enum TaskType {
  maintenance
  weather
  health_summary
}

enum TaskStatus {
  pending
  sent
  acknowledged
  dismissed
}

enum RowStatus {
  active
  fallow
  replanting
  retired
}

enum YieldUnit {
  lb
  kg
  lug
  bin
  flat
  bushel
  other
}

enum ActivityType {
  pruning
  watering
  fertilization
  pest_prevention
  weed_prevention
  harvest
  health_observation
  vine_replacement
  winterization
  other
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  passwordHash      String    @map("password_hash")
  displayName       String    @map("display_name")
  role              UserRole
  tokenVersion      Int       @default(0) @map("token_version")
  notificationPrefs Json      @map("notification_prefs")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  disabledAt        DateTime? @map("disabled_at") @db.Timestamptz(6)

  ownedVineyards     Vineyard[]          @relation("VineyardOwner")
  assignedTasks      Task[]
  passwordResets     PasswordReset[]
  digestLogs         DigestLog[]
  seasonSummaryMails SeasonSummaryMail[]

  @@map("users")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Vineyard {
  id                 String    @id @default(uuid()) @db.Uuid
  ownerId            String    @map("owner_id") @db.Uuid
  name               String
  address            String
  lat                Decimal?  @db.Decimal(9, 6)
  lng                Decimal?  @db.Decimal(9, 6)
  timezone           String
  healthThresholds   Json      @map("health_thresholds")
  varietyCatalog     Json      @default("[]") @map("variety_catalog")
  varietyHarvestTags Json      @default("{}") @map("variety_harvest_tags")
  rowLayout          Json?     @map("row_layout")
  logoPath           String?   @map("logo_path")
  logoContentType    String?   @map("logo_content_type")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner      User       @relation("VineyardOwner", fields: [ownerId], references: [id])
  rows       Row[]
  tasks      Task[]
  harvests   Harvest[]
  activities Activity[]
  seasons    Season[]
  digestLogs DigestLog[]

  @@index([ownerId])
  @@map("vineyards")
}

model Row {
  id              String     @id @default(uuid()) @db.Uuid
  vineyardId      String     @map("vineyard_id") @db.Uuid
  code            String
  name            String
  variety         String
  lengthFeet      Int        @map("length_feet")
  lengthInches    Int        @map("length_inches")
  vineCount       Int        @map("vine_count")
  plantedYear     Int        @map("planted_year")
  status          RowStatus  @default(active)
  notes           String?
  preDeleteCode   String?    @map("pre_delete_code")
  preDeleteStatus RowStatus? @map("pre_delete_status")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  vineyard   Vineyard   @relation(fields: [vineyardId], references: [id], onDelete: Restrict)
  tasks      Task[]
  harvests   Harvest[]
  activities Activity[]

  @@unique([vineyardId, code])
  @@index([vineyardId])
  @@map("rows")
}

/// Scheduled work or notification. Vineyard-wide, or scoped to a row.
/// A hand-written partial unique index (raw SQL in migration seasons_close_new_restore)
/// enforces at most one live task per (season_id, template_key):
///   CREATE UNIQUE INDEX tasks_season_template_key_live_unique
///     ON tasks (season_id, template_key) WHERE template_key IS NOT NULL AND deleted_at IS NULL;
/// Prisma 6 cannot express partial indexes; preserve this index in any future migration.
model Task {
  id                  String        @id @default(uuid()) @db.Uuid
  vineyardId          String        @map("vineyard_id") @db.Uuid
  rowId               String?       @map("row_id") @db.Uuid
  userId              String?       @map("user_id") @db.Uuid
  type                TaskType
  title               String
  body                String
  dueAt               DateTime      @map("due_at") @db.Timestamptz(6)
  status              TaskStatus    @default(pending)
  relatedActivityType ActivityType? @map("related_activity_type")
  templateKey         String?       @map("template_key")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(6)

  vineyard Vineyard @relation(fields: [vineyardId], references: [id], onDelete: Restrict)
  seasonId String?  @map("season_id") @db.Uuid
  season   Season?  @relation(fields: [seasonId, vineyardId], references: [id, vineyardId], onDelete: Restrict, onUpdate: Restrict)
  row      Row?     @relation(fields: [rowId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([vineyardId, dueAt])
  @@index([userId, status])
  @@index([rowId])
  @@index([vineyardId, seasonId])
  @@map("tasks")
}

model Harvest {
  id           String    @id @default(uuid()) @db.Uuid
  rowId        String    @map("row_id") @db.Uuid
  vineyardId   String    @map("vineyard_id") @db.Uuid
  harvestedAt  DateTime  @map("harvested_at") @db.Timestamptz(6)
  yieldAmount  Decimal   @map("yield_amount") @db.Decimal(8, 2)
  yieldUnit    YieldUnit @map("yield_unit")
  notes        String?
  crew         String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  row      Row      @relation(fields: [rowId], references: [id], onDelete: Restrict)
  vineyard Vineyard @relation(fields: [vineyardId], references: [id], onDelete: Restrict)
  seasonId String?  @map("season_id") @db.Uuid
  season   Season?  @relation(fields: [seasonId, vineyardId], references: [id, vineyardId], onDelete: Restrict, onUpdate: Restrict)

  @@index([rowId, harvestedAt])
  @@index([vineyardId, harvestedAt])
  @@index([vineyardId, seasonId])
  @@map("harvests")
}

model Activity {
  id           String       @id @default(uuid()) @db.Uuid
  vineyardId   String       @map("vineyard_id") @db.Uuid
  rowId        String?      @map("row_id") @db.Uuid
  scopeType    String       @map("scope_type")
  scopeId      String       @map("scope_id") @db.Uuid
  activityType ActivityType @map("activity_type")
  performedAt  DateTime     @map("performed_at") @db.Timestamptz(6)
  performedBy  String?      @map("performed_by") @db.Uuid
  details      Json
  source       String       @default("manual")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  vineyard Vineyard @relation(fields: [vineyardId], references: [id], onDelete: Restrict)
  seasonId String?  @map("season_id") @db.Uuid
  season   Season?  @relation(fields: [seasonId, vineyardId], references: [id, vineyardId], onDelete: Restrict, onUpdate: Restrict)
  row      Row?     @relation(fields: [rowId], references: [id], onDelete: SetNull)

  @@index([vineyardId, performedAt])
  @@index([rowId])
  @@index([activityType])
  @@index([vineyardId, seasonId])
  @@map("activities")
}

enum DigestKind {
  scheduled
  test
}

enum DigestStatus {
  sent
  failed
  skipped
}

/// One row per weekly-digest delivery attempt (scheduled or test).
/// A partial unique index (raw SQL in migration 20261007214845_add_digest_log)
/// allows only ONE scheduled row per (vineyard, user, weekStart):
///   CREATE UNIQUE INDEX digest_logs_scheduled_once
///     ON digest_logs (vineyard_id, user_id, week_start) WHERE kind = 'scheduled';
/// Prisma 6 cannot express partial indexes. If a future `migrate dev` proposes
/// DROP INDEX "digest_logs_scheduled_once", delete that line from the new migration.
model DigestLog {
  id                String       @id @default(uuid()) @db.Uuid
  vineyardId        String       @map("vineyard_id") @db.Uuid
  userId            String?      @map("user_id") @db.Uuid
  recipientEmail    String       @map("recipient_email")
  /// Monday of the digest week (America/Chicago calendar date).
  weekStart         DateTime     @map("week_start") @db.Date
  kind              DigestKind
  status            DigestStatus
  error             String?
  providerMessageId String?      @map("provider_message_id")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?    @map("sent_at") @db.Timestamptz(6)

  vineyard Vineyard @relation(fields: [vineyardId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([vineyardId, weekStart])
  @@index([userId])
  @@map("digest_logs")
}

enum SeasonStatus {
  legacy
  active
  planned
  closed
}

enum SeasonSummaryMailStatus {
  pending
  sent
  failed
  skipped
}

// Partial unique indexes (one active / one planned per vineyard) are hand-written SQL in the migration; Prisma cannot express them.
model Season {
  id             String              @id @default(uuid()) @db.Uuid
  vineyardId     String              @map("vineyard_id") @db.Uuid
  year           Int
  status         SeasonStatus
  startedAt      DateTime?           @map("started_at") @db.Timestamptz(6)
  closedAt       DateTime?           @map("closed_at") @db.Timestamptz(6)
  reopenedAt     DateTime?           @map("reopened_at") @db.Timestamptz(6)
  startedBy      String?             @map("started_by") @db.Uuid
  closedBy       String?             @map("closed_by") @db.Uuid
  closeVersion   Int                 @default(0) @map("close_version")
  snapshot       Json?
  summary        Json?
  summaryHistory Json                @default("[]") @map("summary_history")
  /// Calendar template keys the user unchecked when starting this season; "Add missing calendar tasks" never re-adds them.
  declinedTemplateKeys String[]      @default([]) @map("declined_template_keys")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  vineyard       Vineyard            @relation(fields: [vineyardId], references: [id], onDelete: Restrict)
  tasks          Task[]
  harvests       Harvest[]
  activities     Activity[]
  summaryMails   SeasonSummaryMail[]

  @@unique([vineyardId, year])
  @@unique([id, vineyardId])
  @@map("seasons")
}

/// Outbox / delivery intent for Season Summary emails written in the close transaction.
model SeasonSummaryMail {
  id                String                  @id @default(uuid()) @db.Uuid
  seasonId          String                  @map("season_id") @db.Uuid
  vineyardId        String                  @map("vineyard_id") @db.Uuid
  closeVersion      Int                     @map("close_version")
  userId            String?                 @map("user_id") @db.Uuid
  recipientEmail    String                  @map("recipient_email")
  status            SeasonSummaryMailStatus @default(pending)
  attempts          Int                     @default(0)
  lastErrorCode     String?                 @map("last_error_code")
  providerMessageId String?                 @map("provider_message_id")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?               @map("sent_at") @db.Timestamptz(6)

  season Season @relation(fields: [seasonId, vineyardId], references: [id, vineyardId], onDelete: Restrict, onUpdate: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([seasonId, closeVersion, recipientEmail])
  @@index([status, createdAt])
  @@map("season_summary_mails")
}

