// Persistence slice: vineyard rows and scheduled tasks.
// User + Vineyard exist so foreign keys stay real. Parcel groupings can return later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  power_user
  manager
  viewer
}

enum TaskType {
  maintenance
  weather
  health_summary
}

enum TaskStatus {
  pending
  sent
  acknowledged
  dismissed
}

enum RowStatus {
  active
  fallow
  replanting
  retired
}

enum YieldUnit {
  lb
  kg
  lug
  bin
  flat
  bushel
  other
}

enum ActivityType {
  pruning
  watering
  fertilization
  pest_prevention
  weed_prevention
  harvest
  health_observation
  vine_replacement
  winterization
  other
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  passwordHash      String    @map("password_hash")
  displayName       String    @map("display_name")
  role              UserRole
  notificationPrefs Json      @map("notification_prefs")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  ownedVineyards Vineyard[] @relation("VineyardOwner")
  assignedTasks  Task[]

  @@map("users")
}

model Vineyard {
  id               String    @id @default(uuid()) @db.Uuid
  ownerId          String    @map("owner_id") @db.Uuid
  name             String
  address          String
  lat              Decimal?  @db.Decimal(9, 6)
  lng              Decimal?  @db.Decimal(9, 6)
  timezone         String
  healthThresholds Json      @map("health_thresholds")
  logoPath         String?   @map("logo_path")
  logoContentType  String?   @map("logo_content_type")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner      User       @relation("VineyardOwner", fields: [ownerId], references: [id])
  rows       Row[]
  tasks      Task[]
  harvests   Harvest[]
  activities Activity[]

  @@index([ownerId])
  @@map("vineyards")
}

model Row {
  id           String    @id @default(uuid()) @db.Uuid
  vineyardId   String    @map("vineyard_id") @db.Uuid
  code         String
  name         String
  variety      String
  lengthFeet   Int       @map("length_feet")
  lengthInches Int       @map("length_inches")
  vineCount    Int       @map("vine_count")
  plantedYear  Int       @map("planted_year")
  status       RowStatus @default(active)
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  vineyard   Vineyard   @relation(fields: [vineyardId], references: [id], onDelete: Restrict)
  tasks      Task[]
  harvests   Harvest[]
  activities Activity[]

  @@unique([vineyardId, code])
  @@index([vineyardId])
  @@map("rows")
}

/// Scheduled work or notification. Vineyard-wide, or scoped to a row.
model Task {
  id                  String        @id @default(uuid()) @db.Uuid
  vineyardId          String        @map("vineyard_id") @db.Uuid
  rowId               String?       @map("row_id") @db.Uuid
  userId              String?       @map("user_id") @db.Uuid
  type                TaskType
  title               String
  body                String
  dueAt               DateTime      @map("due_at") @db.Timestamptz(6)
  status              TaskStatus    @default(pending)
  relatedActivityType ActivityType? @map("related_activity_type")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(6)

  vineyard Vineyard @relation(fields: [vineyardId], references: [id], onDelete: Restrict)
  row      Row?     @relation(fields: [rowId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([vineyardId, dueAt])
  @@index([userId, status])
  @@index([rowId])
  @@map("tasks")
}

model Harvest {
  id           String    @id @default(uuid()) @db.Uuid
  rowId        String    @map("row_id") @db.Uuid
  vineyardId   String    @map("vineyard_id") @db.Uuid
  harvestedAt  DateTime  @map("harvested_at") @db.Timestamptz(6)
  yieldAmount  Decimal   @map("yield_amount") @db.Decimal(8, 2)
  yieldUnit    YieldUnit @map("yield_unit")
  notes        String?
  crew         String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  row      Row      @relation(fields: [rowId], references: [id], onDelete: Restrict)
  vineyard Vineyard @relation(fields: [vineyardId], references: [id], onDelete: Restrict)

  @@index([rowId, harvestedAt])
  @@index([vineyardId, harvestedAt])
  @@map("harvests")
}

model Activity {
  id           String       @id @default(uuid()) @db.Uuid
  vineyardId   String       @map("vineyard_id") @db.Uuid
  rowId        String?      @map("row_id") @db.Uuid
  scopeType    String       @map("scope_type")
  scopeId      String       @map("scope_id") @db.Uuid
  activityType ActivityType @map("activity_type")
  performedAt  DateTime     @map("performed_at") @db.Timestamptz(6)
  performedBy  String?      @map("performed_by") @db.Uuid
  details      Json
  source       String       @default("manual")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  vineyard Vineyard @relation(fields: [vineyardId], references: [id], onDelete: Restrict)
  row      Row?     @relation(fields: [rowId], references: [id], onDelete: SetNull)

  @@index([vineyardId, performedAt])
  @@index([rowId])
  @@index([activityType])
  @@map("activities")
}
